    <!-- The welcome tour -->
    <string name="welcome_tag">welcome</string>
    <string name="onboard_title">A phone made of dots</string>
    <string name="onboard_body">Dot Phone is a dialer in the dot-matrix style: a keypad, your recents, your people and the ones you star. Give a contact a photo of your own and it becomes a spinning record of dots whenever they call.</string>
    <string name="onboard_role_title">Be the phone app</string>
    <string name="onboard_role_body">Android only lets one app make calls and draw the in-call screen. Choose Dot Phone and every call gets the dot record. Until then, calls go to whichever phone app is the default.</string>
    <string name="onboard_access_title">Two permissions, nothing else</string>
    <string name="onboard_access_body">Contacts and call history are read on this phone only, to show names, photos and your recents. Dot has no account and sends nothing anywhere.</string>
    <string name="onboard_style_title">Make it yours</string>
    <string name="onboard_style_body">White dots follow Nothing\'s style; off keeps each photo\'s own colours. You can change this later in settings, and each contact can have its own photo.</string>
